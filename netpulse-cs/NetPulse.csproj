<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 自己写 Main，禁用 SDK 自动生成的 App 入口，否则我们的 Main 会被忽略 -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <StartupObject>NetPulse.App</StartupObject>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>NetPulse</AssemblyName>
    <RootNamespace>NetPulse</RootNamespace>
    <ApplicationManifest Condition="'$(Configuration)'=='Release'">app.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(Configuration)'!='Release'">app.test.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>
